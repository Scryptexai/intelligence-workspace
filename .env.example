# ============================================================
# Intelligence Workspace — Environment Variables
# Salin file ini menjadi `.env.local` lalu sesuaikan.
# Semua variabel OPSIONAL — aplikasi berjalan penuh (mock) tanpa env.
# ============================================================

# --- Sumber data -------------------------------------------------
# mock    = data riset lokal (lib/data) — default, tanpa backend
# backend = panggil REST API (lihat docs/API_CONTRACT.md)
#
# ⚠️ OPSIONAL sejak v2.1 — AUTO-DETECT:
#    - Server mendeteksi otomatis: jika Supabase REST atau DATABASE_URL
#      terkonfigurasi, mode menjadi "backend" walau variabel ini tidak diset.
#    - Frontend ikut beralih otomatis saat boot (baca /api/config), jadi
#      data Supabase langsung tampil tanpa perlu variabel ini.
#    Set variabel ini hanya jika ingin MEMAKSA mode tertentu (mis. mock
#    walaupun DB terpasang).
# NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL API backend.
# - Same-origin: biarkan "/api" (pakai API routes bawaan)
# - Backend eksternal: https://api.anda.com/api
NEXT_PUBLIC_API_BASE_URL=/api

# Token opsional → dikirim sebagai "Authorization: Bearer <token>"
# (hanya dibaca server-side)
# API_TOKEN=

# --- PostgreSQL LANGSUNG (OPSIONAL) --------------------------------
# Hanya dibutuhkan untuk mode backend + DB via pg (bukan Supabase REST),
# dan agar /api/health hijau.
# Contoh Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- SUPABASE REST (REKOMENDASI untuk Supabase) -------------------
# Cukup set DUA variabel ini → frontend OTOMATIS memuat data Supabase
# (tidak perlu NEXT_PUBLIC_DATA_SOURCE=backend).
# Server membaca tabel relasional (projects, knowledge_items, entities,
# events, conflicts, …) via PostgREST (HTTPS) — lebih andal dari koneksi
# DB langsung (host direct Supabase sering IPv6-only).
# Dapatkan di Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# (opsional) untuk akses read dari browser (mis. integrasi auth nanti)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- ENTERPRISE (Phase 0–2) ------------------------------------------
# SUPABASE_SECRET_KEY dipakai SERVER-SIDE untuk SEMUA baca & tulis runtime:
# projects/knowledge/events/…, Activity Ledger (audit_log), manajemen
# anggota workspace, notes & saved views. Jangan pernah commit secret ini
# ke git (lihat .gitignore) — set di Vercel Dashboard / env CI.
#
# Migrasi enterprise (workspaces, audit_log + trigger, kolom provenance,
# RLS per role admin/editor/viewer) — jalankan SEKALI di Supabase SQL Editor
# dengan menempel isi: supabase/apply_enterprise_phase0_phase2.sql
# (atau via CLI: supabase link --project-ref uqtvjerhgvwoxiejvrli &&
#  supabase db push).
#
# ⚠️ Setelah migrasi Phase 2: role anon (publishable key) TIDAK lagi bisa
# membaca tabel inti (RLS tanpa policy anon). Aplikasi tetap jalan karena
# memakai service key. Bila ingin read-only anon untuk demo, tambahkan
# policy SELECT anon (contoh ada di bagian Phase 2 migrasi).

# --- SETUP DATABASE (sekali saja) ----------------------------------
# 1. Skema: 13 tabel relasional SUDAH tersedia di Supabase
#    (projects, knowledge_items, evidence_items, entities, relationships,
#     events, conflicts, qa_dimensions, qa_phases, behavior_profiles,
#     notes, saved_views, users) — kolom sesuai supabase/schema.sql.
#    Tabel enterprise (workspaces, workspace_members, audit_log) dibuat
#    oleh migrasi Phase 0/2 (lihat bagian ENTERPRISE di atas).
# 2. Data: isi otomatis lewat salah satu cara:
#    - GitHub Actions (disarankan): set repo secrets SUPABASE_URL +
#      SUPABASE_SECRET_KEY → setiap push ke master auto-seed.
#    - CLI lokal:   npm run seed:rest   (idempotent, skip jika sudah terisi)
#    - URL bootstrap: GET /api/seed      (seed hanya jika tabel kosong)
# 3. Jalankan: npm run dev → header menampilkan badge "Supabase" (hijau).

# --- VEREL DEPLOYMENT ----------------------------------------------
# Tambahkan di Vercel → Project → Settings → Environment Variables:
#   NEXT_PUBLIC_SUPABASE_URL   = https://uqtvjerhgvwoxiejvrli.supabase.co
#   SUPABASE_SECRET_KEY        = sb_secret_...
#   (opsional) DATABASE_URL    = postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Tanpa variabel ini, app di Vercel berjalan di mock mode.
