# ============================================================
# Intelligence Workspace — Environment Variables
# Salin file ini menjadi `.env.local` lalu sesuaikan.
# Semua variabel OPSIONAL — aplikasi berjalan penuh (mock) tanpa env.
# ============================================================

# --- Sumber data -------------------------------------------------
# mock    = data riset lokal (lib/data) — default, tanpa backend
# backend = panggil REST API (lihat docs/API_CONTRACT.md)
#
# ⚠️ OPSIONAL sejak v2.1 — AUTO-DETECT:
#    - Server mendeteksi otomatis: jika Supabase REST atau DATABASE_URL
#      terkonfigurasi, mode menjadi "backend" walau variabel ini tidak diset.
#    - Frontend ikut beralih otomatis saat boot (baca /api/config), jadi
#      data Supabase langsung tampil tanpa perlu variabel ini.
#    Set variabel ini hanya jika ingin MEMAKSA mode tertentu (mis. mock
#    walaupun DB terpasang).
# NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL API backend.
# - Same-origin: biarkan "/api" (pakai API routes bawaan)
# - Backend eksternal: https://api.anda.com/api
NEXT_PUBLIC_API_BASE_URL=/api

# Token opsional → dikirim sebagai "Authorization: Bearer <token>"
# (hanya dibaca server-side)
# API_TOKEN=

# --- PostgreSQL LANGSUNG (OPSIONAL) --------------------------------
# Hanya dibutuhkan untuk mode backend + DB via pg (bukan Supabase REST),
# dan agar /api/health hijau.
# Contoh Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- SUPABASE REST (REKOMENDASI untuk Supabase) -------------------
# Cukup set DUA variabel ini → frontend OTOMATIS memuat data Supabase
# (tidak perlu NEXT_PUBLIC_DATA_SOURCE=backend).
# Server membaca tabel relasional (projects, knowledge_items, entities,
# events, conflicts, …) via PostgREST (HTTPS) — lebih andal dari koneksi
# DB langsung (host direct Supabase sering IPv6-only).
# Dapatkan di Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Langkah setup sekali saja:
#   1. Terapkan skema:   npx drizzle-kit push          (butuh DATABASE_URL)
#      atau tempel drizzle/0000_*.sql di Supabase SQL Editor
#   2. Isi data:         tempel supabase/seed.sql di Supabase SQL Editor
#      (full dataset — regenerate dengan: npx tsx scripts/build-seed-sql.ts)
#   3. Jalankan:         npm run dev → header menampilkan badge "Supabase"

# (opsional) bila nanti integrasi auth supabase-js
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
